# 환경 변수 설정 가이드

# Google API Key (RAG 임베딩용)
# https://console.cloud.google.com에서 발급받으세요
GOOGLE_API_KEY=your_google_api_key_here

# 프로젝트 설정 (선택사항)
PROJECT_NAME=waterproof_planner
ENVIRONMENT=development

# 데이터베이스 경로 (기본값: 현재 디렉토리/data)
DATA_DIR=data

# Chroma Vector DB 경로
CHROMA_DB_PATH=data/chroma_db

# 로깅 레벨
LOG_LEVEL=INFO
